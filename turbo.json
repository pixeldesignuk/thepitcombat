{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "operations/timetable.json",
    "operations/generate_timetable.py"
  ],
  "globalPassThroughEnv": [
    "PORT",
    "HOST",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "PUBLIC_SITE_URL",
        "VITE_API_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_URL",
        "PUBLIC_SITE_URL",
        "VITE_API_URL",
        "OPERATOR_NAME",
        "PRIVACY_EMAIL",
        "CORRESPONDENCE_ADDRESS"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "passThroughEnv": [
        "API_URL",
        "PUBLIC_SITE_URL",
        "VITE_API_URL",
        "OPERATOR_NAME",
        "PRIVACY_EMAIL",
        "CORRESPONDENCE_ADDRESS"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_URL",
        "PUBLIC_SITE_URL",
        "VITE_API_URL",
        "OPERATOR_NAME",
        "PRIVACY_EMAIL",
        "CORRESPONDENCE_ADDRESS"
      ]
    },
    "@pit/api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "API_PORT",
        "ADMIN_API_TOKEN",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "REPLY_TO_EMAIL",
        "PUBLIC_SITE_URL",
        "DASH_URL"
      ]
    },
    "@pit/api#test": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "API_PORT",
        "ADMIN_API_TOKEN",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "REPLY_TO_EMAIL",
        "PUBLIC_SITE_URL",
        "DASH_URL",
        "TEST_DATABASE_URL"
      ]
    },
    "@pit/api#start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "API_PORT",
        "ADMIN_API_TOKEN",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "REPLY_TO_EMAIL",
        "PUBLIC_SITE_URL",
        "DASH_URL"
      ]
    }
  }
}
