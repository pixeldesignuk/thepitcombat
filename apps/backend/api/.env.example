# Copy to .env in this directory. This file is safe to commit; .env is private.
DATABASE_URL=postgresql://pit:pit_dev@localhost:55432/pit
API_PORT=3001
PUBLIC_SITE_URL=http://localhost:4321
DASH_URL=http://localhost:5173

# Private Better Auth service URL. The API verifies each staff session here.
AUTH_INTERNAL_URL=http://localhost:3002

# Use a Resend-verified sender. Missing configuration leaves confirmations queued.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
REPLY_TO_EMAIL=
