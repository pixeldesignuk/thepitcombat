# Public-site server configuration. Database and Resend credentials belong to apps/backend/api/.env.
API_URL=http://localhost:3001
# Set this before building; Astro trusts this exact public origin behind the Railway proxy.
PUBLIC_SITE_URL=http://localhost:4321
# Optional: fill only with real adopted operator/contact details.
OPERATOR_NAME=
PRIVACY_EMAIL=
CORRESPONDENCE_ADDRESS=
